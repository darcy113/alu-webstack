global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    ca-base /etc/ssl/certs
    crt-base /etc/ssl/private

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend web_front
    bind *:80
    bind *:443 ssl crt /etc/haproxy/certs/www.darcy113.tech.pem
    default_backend web_servers

backend web_servers
    balance roundrobin
    server web-01 34.226.246.158:80 check
    server web-02 18.207.221.178:80 check

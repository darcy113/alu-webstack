
#!/usr/bin/env bash
# Displays DNS information for a domain's subdomains

domain=$1

display_subdomain() {
    subdomain=$1

    dig "$subdomain.$domain" |
    awk -v subdomain="$subdomain" '
    $3 == "IN" {
        print "The subdomain " subdomain " is a " $4 " record and points to " $5
        exit
    }'
}

if [ -n "$2" ]; then
    display_subdomain "$2"
else
    for subdomain in www lb-01 web-01 web-02
    do
        display_subdomain "$subdomain"
    done
fi


